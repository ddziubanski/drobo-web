# /etc/default/drobo-web : every setting is optional.
DROBOWEB_DEVICE=auto
DROBOWEB_PORT=8080
DROBOWEB_POLL_SECONDS=10
DROBOWEB_RETENTION_DAYS=90
DROBOWEB_TEMP_WARN_C=50
DROBOWEB_CAPACITY_WARN_PCT=85

# Protect the page (HTTP basic auth). Leave empty for no login.
DROBOWEB_AUTH_USER=
DROBOWEB_AUTH_PASSWORD=

# Alerts: warning and critical events by default.
DROBOWEB_NOTIFY_MIN_SEVERITY=warning
DROBOWEB_WEBHOOK_URL=
DROBOWEB_WEBHOOK_FORMAT=json
DROBOWEB_SMTP_HOST=
DROBOWEB_SMTP_PORT=587
DROBOWEB_SMTP_USER=
DROBOWEB_SMTP_PASSWORD=
DROBOWEB_SMTP_STARTTLS=true
DROBOWEB_MAIL_FROM=
DROBOWEB_MAIL_TO=
